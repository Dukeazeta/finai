# Postgres. Neon: DATABASE_URL = pooled endpoint, DIRECT_URL = direct endpoint (used for migrations).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (redirect URI: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Optional: password reset emails. Without it, reset links are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=FinAI <onboarding@resend.dev>

# Pulse (built-in monitoring). Emails that can open /app/pulse, comma separated.
PULSE_ADMINS=
# Protects the daily clean-up job. Vercel Cron sends it automatically when set in the project.
CRON_SECRET=
